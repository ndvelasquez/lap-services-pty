{
  "name": "LAP - Nueva Cita",
  "nodes": [
    {
      "id": "webhook-appointment",
      "name": "Webhook Nueva Cita",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [200, 300],
      "onError": "continueRegularOutput",
      "parameters": {
        "path": "new-appointment",
        "httpMethod": "POST",
        "authentication": "none",
        "responseMode": "responseNode"
      },
      "webhookId": "94f7f515-f5df-4c3d-b049-da7b5c5d20aa"
    },
    {
      "id": "fetch-new-appointment",
      "name": "Fetch Appointment Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [440, 300],
      "onError": "continueRegularOutput",
      "credentials": {"supabaseApi": {"id": "gsQUFcI43y3e2L9D", "name": "Supabase account"}},
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {},
        "url": "=https://ntcdwswelewwxmyuhbtr.supabase.co/rest/v1/appointments?id=eq.{{ $('Webhook Nueva Cita').item.json.body.id }}&select=*,profiles!appointments_client_id_fkey(id,name,email,phone),appointment_services(services(name))"
      }
    },
    {
      "id": "build-nueva-cita-data",
      "name": "Build Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const webhookBody = $('Webhook Nueva Cita').item.json.body || {};\nconst appt = $input.first().json;\n\nconst client = (appt && appt.profiles) || {};\nconst services = (appt && appt.appointment_services || []).map(s => s.services && s.services.name).filter(Boolean);\nconst serviceNames = services.length ? services.join(', ') : (Array.isArray(webhookBody.serviceNames) ? webhookBody.serviceNames.join(', ') : 'N/A');\n\nconst clientName = client.name || webhookBody.clientName || 'Cliente';\nconst clientEmail = client.email || webhookBody.clientEmail || '';\nconst clientPhone = client.phone || webhookBody.clientPhone || 'N/A';\n\nlet fecha = 'N/A';\nlet hora = 'N/A';\nlet horaFin = 'N/A';\nif (appt && appt.appointment_date) {\n  fecha = new Date(appt.appointment_date + 'T12:00:00').toLocaleDateString('es-PA', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\n}\nif (appt && appt.start_time) hora = appt.start_time.slice(0, 5);\nif (appt && appt.end_time) horaFin = appt.end_time.slice(0, 5);\nconst location = (appt && appt.location_address) || 'N/A';\n\nreturn [{ json: { clientName, clientEmail, clientPhone, serviceNames, fecha, hora, horaFin, location, appointmentId: (appt && appt.id) || webhookBody.id || 'N/A' } }];"
      }
    },
    {
      "id": "send-admin-email",
      "name": "Email Admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [920, 180],
      "credentials": {"smtp": {"id": "artdogaUIFL4Iba9", "name": "SMTP account"}},
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "noreply@lapservicepty.com",
        "toEmail": "ndvelasquezl@gmail.com",
        "subject": "=🗓️ Nueva Cita — {{ $json.clientName }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\"><div style=\"background:#0D1117;border-radius:12px;padding:24px;text-align:center;\"><h1 style=\"color:#4CAF50;margin:0;\">LAP Services PTY</h1></div><div style=\"background:white;border-radius:12px;padding:24px;margin-top:12px;border:1px solid #e0e0e0;\"><h2 style=\"color:#1a1a2e;\">🗓️ Nueva Solicitud de Cita</h2><table style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Cliente</td><td style=\"padding:8px 12px;\">{{ $json.clientName }}</td></tr><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Email</td><td style=\"padding:8px 12px;\"><a href=\"mailto:{{ $json.clientEmail }}\">{{ $json.clientEmail }}</a></td></tr><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Teléfono</td><td style=\"padding:8px 12px;\">{{ $json.clientPhone }}</td></tr><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Servicios</td><td style=\"padding:8px 12px;\">{{ $json.serviceNames }}</td></tr><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Fecha</td><td style=\"padding:8px 12px;\">{{ $json.fecha }}</td></tr><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Hora</td><td style=\"padding:8px 12px;\">{{ $json.hora }} – {{ $json.horaFin }}</td></tr><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Dirección</td><td style=\"padding:8px 12px;\">{{ $json.location }}</td></tr></table><p style=\"margin-top:20px;color:#666;\">Ve a <a href=\"https://lapservicepty.com/admin/citas\">Admin → Citas</a> para confirmar o gestionar esta solicitud.</p></div></div>"
      }
    },
    {
      "id": "send-client-email",
      "name": "Email Cliente",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [920, 420],
      "credentials": {"smtp": {"id": "artdogaUIFL4Iba9", "name": "SMTP account"}},
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "noreply@lapservicepty.com",
        "toEmail": "={{ $json.clientEmail }}",
        "subject": "LAP Services PTY — Tu cita ha sido recibida ✅",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\"><div style=\"background:#0D1117;border-radius:12px;padding:24px;text-align:center;\"><h1 style=\"color:#4CAF50;margin:0;\">LAP Services PTY</h1></div><div style=\"background:white;border-radius:12px;padding:24px;margin-top:12px;\"><h2 style=\"color:#1a1a2e;\">✅ ¡Solicitud recibida!</h2><p>Hola <strong>{{ $json.clientName }}</strong>,</p><p>Hemos recibido tu solicitud de cita para <strong>{{ $json.serviceNames }}</strong>.</p><table style=\"width:100%;border-collapse:collapse;margin:16px 0;\"><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Fecha</td><td style=\"padding:8px 12px;\">{{ $json.fecha }}</td></tr><tr><td style=\"padding:8px 12px;font-weight:bold;background:#f5f5f5;\">Hora</td><td style=\"padding:8px 12px;\">{{ $json.hora }} – {{ $json.horaFin }}</td></tr></table><p>Te notificaremos cuando tu cita sea confirmada.</p><p style=\"color:#666;font-size:14px;\">Si tienes preguntas, contáctanos por WhatsApp.</p></div></div>"
      }
    },
    {
      "id": "respond-appointment",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1160, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"Appointment notifications sent\" }"
      }
    }
  ],
  "connections": {
    "Webhook Nueva Cita": {"main": [[{"node": "Fetch Appointment Data", "type": "main", "index": 0}]]},
    "Fetch Appointment Data": {"main": [[{"node": "Build Email Data", "type": "main", "index": 0}]]},
    "Build Email Data": {"main": [[{"node": "Email Admin", "type": "main", "index": 0}, {"node": "Email Cliente", "type": "main", "index": 0}]]},
    "Email Admin": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]},
    "Email Cliente": {"main": [[{"node": "Respond OK", "type": "main", "index": 0}]]}
  }
}
